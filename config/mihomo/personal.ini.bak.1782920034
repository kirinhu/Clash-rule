[custom]

;==================================================
; Mihomo 动态规则集 (Rule Providers) 定义 - 100% 真实可用链接
;==================================================
; 基础与去广告/DNS（拦截与本地保护优先）
ruleset=🚫 广告拦截,clash-classic:https://raw.githubusercontent.com/QuixoticHeart/rule-set/refs/heads/ruleset/meta/adrules.list
; 私有网络/本地域名直连：内联维护，避免上游规则里的逗号正则被订阅转换器误拆
ruleset=🎯 全球直连,[]DOMAIN-SUFFIX,lan
ruleset=🎯 全球直连,[]DOMAIN-SUFFIX,local
ruleset=🎯 全球直连,[]DOMAIN-SUFFIX,localdomain
