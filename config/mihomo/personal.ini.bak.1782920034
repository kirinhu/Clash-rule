; 基础地理/Final兜底
ruleset=🎯 全球直连,[]GEOSITE,CN
ruleset=🚀 节点选择,[]GEOSITE,geolocation-!cn
ruleset=🎯 全球直连,[]GEOIP,CN
ruleset=🐟 漏网之鱼,[]FINAL

;==================================================
; 自动测速筛选组（按地区 + 自建 / 订阅筛选，不再区分直连与 WARP）
; 自建节点名需包含“自建”；不含“自建”的同地区节点视为订阅节点
;==================================================
custom_proxy_group=🇺🇸 美国自建`url-test`(?=.*(美国|US|United States|USA|🇺🇸))(?=.*自建)`http://cp.cloudflare.com/generate_204`300,,50
custom_proxy_group=🇺🇸 美国订阅`url-test`(?=.*(美国|US|United States|USA|🇺🇸))^((?!自建).)*$`http://cp.cloudflare.com/generate_204`300,,50
custom_proxy_group=🇭🇰 香港自建`url-test`(?=.*(香港|HK|Hong Kong|🇭🇰))(?=.*自建)`http://cp.cloudflare.com/generate_204`300,,50
custom_proxy_group=🇭🇰 香港订阅`url-test`(?=.*(香港|HK|Hong Kong|🇭🇰))^((?!自建).)*$`http://cp.cloudflare.com/generate_204`300,,50

;==================================================
; 上层业务分流策略组
;==================================================
custom_proxy_group=🚀 节点选择`select`[]🇭🇰 香港自建`[]🇺🇸 美国自建`[]🇭🇰 香港订阅`[]🇺🇸 美国订阅`[]DIRECT

; 广告拦截组：默认 REJECT（拒绝连接），可手动切换为 DIRECT 解决误杀
custom_proxy_group=🚫 广告拦截`select`[]REJECT`[]DIRECT`[]🚀 节点选择

custom_proxy_group=📹 YouTube`select`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🚀 节点选择
custom_proxy_group=🤖 AI`select`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🚀 节点选择`[]DIRECT
custom_proxy_group=💧 Copilot`select`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🚀 节点选择`[]DIRECT
custom_proxy_group=🐬 OneDrive`select`[]DIRECT`[]🇭🇰 香港自建`[]🇺🇸 美国自建`[]🇭🇰 香港订阅`[]🇺🇸 美国订阅`[]🚀 节点选择
custom_proxy_group=🪟 Microsoft`select`[]DIRECT`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🚀 节点选择
custom_proxy_group=🍀 Google`select`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🚀 节点选择
custom_proxy_group=👨🏿💻 GitHub`select`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🚀 节点选择`[]DIRECT
custom_proxy_group=🍎 Apple`select`[]DIRECT`[]🇭🇰 香港自建`[]🇺🇸 美国自建`[]🇭🇰 香港订阅`[]🇺🇸 美国订阅`[]🚀 节点选择
custom_proxy_group=♻️ Speedtest`select`[]🇭🇰 香港自建`[]🇺🇸 美国自建`[]🇭🇰 香港订阅`[]🇺🇸 美国订阅`[]DIRECT`[]🚀 节点选择
custom_proxy_group=💳 支付服务`select`[]DIRECT`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🚀 节点选择
custom_proxy_group=🛡️ 下载避险`select`[]DIRECT`[]REJECT`[]🚀 节点选择
custom_proxy_group=🎵 TikTok`select`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🚀 节点选择
custom_proxy_group=🎥 Netflix`select`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🚀 节点选择
custom_proxy_group=📲 社交消息`select`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🚀 节点选择`[]DIRECT
custom_proxy_group=📢 FCM`select`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]DIRECT`[]🚀 节点选择
custom_proxy_group=🎮 游戏平台`select`[]DIRECT`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🚀 节点选择
custom_proxy_group=🌍 国外媒体`select`[]🇭🇰 香港自建`[]🇭🇰 香港订阅`[]🇺🇸 美国自建`[]🇺🇸 美国订阅`[]🚀 节点选择
custom_proxy_group=🎞️ 国内媒体`select`[]DIRECT`[]🚀 节点选择
custom_proxy_group=🎯 全球直连`select`[]DIRECT`[]🚀 节点选择
custom_proxy_group=🐟 漏网之鱼`select`[]🚀 节点选择`[]DIRECT
;==================================================
; 生成器开关
;==================================================
enable_rule_generator=true
overwrite_original_rules=true
